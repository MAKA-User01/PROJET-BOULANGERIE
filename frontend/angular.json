{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "boulangerie-erp": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/boulangerie-erp",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/favicon.svg",
              "src/assets"
            ],
            "styles": [
              "node_modules/@fontsource/fraunces/latin-500.css",
              "node_modules/@fontsource/fraunces/latin-600.css",
              "node_modules/@fontsource/fraunces/latin-700.css",
              "node_modules/@fontsource/fraunces/latin-500-italic.css",
              "node_modules/@fontsource/manrope/latin-400.css",
              "node_modules/@fontsource/manrope/latin-500.css",
              "node_modules/@fontsource/manrope/latin-600.css",
              "node_modules/@fontsource/manrope/latin-700.css",
              "node_modules/@fontsource/manrope/latin-800.css",
              "src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "35kb",
                  "maximumError": "45kb"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ]
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "browserTarget": "boulangerie-erp:build:production"
            },
            "development": {
              "browserTarget": "boulangerie-erp:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}